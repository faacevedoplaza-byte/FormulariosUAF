@using FormulariosUAF.Models.Enums
@using FormulariosUAF.Pages.Cliente
@model (int Index, DeclaracionModel.PersonaInput Data)
@{
    var i = Model.Index;
    var p = Model.Data;
}
<div class="persona-row card border mb-3 shadow-sm" data-idx="@i">
    <div class="card-header d-flex justify-content-between align-items-center bg-light py-2">
        <span class="fw-semibold text-primary small">Persona <span class="persona-num">@(i + 1)</span></span>
        <button type="button" class="btn btn-sm btn-outline-danger btn-remove-persona">
            <i class="fa-solid fa-trash"></i> Eliminar
        </button>
    </div>
    <div class="card-body">
        <div class="row g-2">
            <div class="col-md-3">
                <label class="form-label small">RUT / N° ID <span class="text-danger">*</span></label>
                <input name="Input.Personas[@i].IdNumber" value="@p.IdNumber" class="form-control form-control-sm" required />
            </div>
            <div class="col-md-5">
                <label class="form-label small">Nombre completo <span class="text-danger">*</span></label>
                <input name="Input.Personas[@i].FullName" value="@p.FullName" class="form-control form-control-sm" required />
            </div>
            <div class="col-md-4">
                <label class="form-label small">Tipo de relación <span class="text-danger">*</span></label>
                <select name="Input.Personas[@i].RelationshipType" class="form-select form-select-sm">
                    @foreach (var rt in Enum.GetValues<RelationshipType>())
                    {
                        <option value="@((int)rt)" selected="@(rt == p.RelationshipType)">@rt.ToDisplayString()</option>
                    }
                </select>
            </div>
            <div class="col-md-5">
                <label class="form-label small">Domicilio</label>
                <input name="Input.Personas[@i].Address" value="@p.Address" class="form-control form-control-sm" />
            </div>
            <div class="col-md-3">
                <label class="form-label small">Ciudad</label>
                <input name="Input.Personas[@i].City" value="@p.City" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2">
                <label class="form-label small">País</label>
                <input name="Input.Personas[@i].Country" value="@(string.IsNullOrEmpty(p.Country) ? "Chile" : p.Country)" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2">
                <label class="form-label small">% Participación</label>
                <input name="Input.Personas[@i].ParticipationPercentage" value="@p.ParticipationPercentage" type="number" min="0" max="100" step="0.01" class="form-control form-control-sm pct-input" />
            </div>
            <div class="col-12 border-top pt-2 mt-1">
                <div class="row g-2">
                    <div class="col-md-3">
                        <div class="form-check">
                            <input type="checkbox" name="Input.Personas[@i].HasMinTenPercentParticipation" value="true" class="form-check-input chk-10pct" @(p.HasMinTenPercentParticipation ? "checked" : "") />
                            <label class="form-check-label small">Participación ≥ 10%</label>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-check">
                            <input type="checkbox" name="Input.Personas[@i].IsEffectiveController" value="true" class="form-check-input chk-control" @(p.IsEffectiveController ? "checked" : "") />
                            <label class="form-check-label small">Ejerce control efectivo</label>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-check">
                            <input type="checkbox" name="Input.Personas[@i].HandlesCashOrFunds" value="true" class="form-check-input" @(p.HandlesCashOrFunds ? "checked" : "") />
                            <label class="form-check-label small">Maneja fondos/efectivo</label>
                        </div>
                    </div>
                    <div class="col-12 desc-control" style="display:@(p.IsEffectiveController ? "block" : "none")">
                        <input name="Input.Personas[@i].EffectiveControlDescription" value="@p.EffectiveControlDescription" class="form-control form-control-sm" placeholder="Describa el control efectivo ejercido..." />
                    </div>
                </div>
            </div>
            <div class="col-12 border-top pt-2 mt-1">
                <div class="form-check">
                    <input type="checkbox" name="Input.Personas[@i].IsPEP" value="true" class="form-check-input chk-pep" @(p.IsPEP ? "checked" : "") />
                    <label class="form-check-label small fw-semibold text-danger">¿Es Persona Expuesta Políticamente (PEP)?</label>
                </div>
                <div class="pep-detail mt-2 border rounded p-2 bg-light" style="display:@(p.IsPEP ? "block" : "none")">
                    <div class="row g-2">
                        <div class="col-md-3">
                            <label class="form-label small">Tipo PEP <span class="text-danger">*</span></label>
                            <select name="Input.Personas[@i].PepType" class="form-select form-select-sm">
                                <option value="">— Seleccione —</option>
                                @foreach (var pt in Enum.GetValues<PepType>())
                                {
                                    <option value="@((int)pt)" selected="@(p.PepType == pt)">@pt.ToDisplayString()</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small">Nombre PEP</label>
                            <input name="Input.Personas[@i].PepTypeName" value="@p.PepTypeName" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small">Institución</label>
                            <input name="Input.Personas[@i].PepInstitution" value="@p.PepInstitution" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small">Cargo / Motivo</label>
                            <input name="Input.Personas[@i].PepPosition" value="@p.PepPosition" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small">Relación con el PEP</label>
                            <input name="Input.Personas[@i].PepRelationship" value="@p.PepRelationship" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label small">Observación</label>
                            <input name="Input.Personas[@i].PepObservation" value="@p.PepObservation" class="form-control form-control-sm" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
