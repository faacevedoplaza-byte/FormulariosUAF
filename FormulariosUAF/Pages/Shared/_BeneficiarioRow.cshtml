@model FormulariosUAF.Pages.Cliente.BeneficiarioRowModel
@{
    var i = Model.Index == -1 ? "__INDEX__" : Model.Index.ToString();
    var d = Model.Data;
}
<div class="benef-row card border mb-3 p-3">
    <div class="d-flex justify-content-between mb-2">
        <span class="fw-bold text-primary small">Beneficiario</span>
        <button type="button" class="btn btn-sm btn-outline-danger btn-remove-benef">
            <i class="fa-solid fa-trash"></i>
        </button>
    </div>
    <div class="row g-2">
        <div class="col-md-4">
            <label class="form-label small">RUT / N° ID <span class="text-danger">*</span></label>
            <input name="beneficiarios[@i].IdNumber" value="@d.IdNumber" class="form-control form-control-sm" placeholder="12.345.678-9" required />
        </div>
        <div class="col-md-8">
            <label class="form-label small">Nombre Completo <span class="text-danger">*</span></label>
            <input name="beneficiarios[@i].FullName" value="@d.FullName" class="form-control form-control-sm" placeholder="Nombre Apellido" required />
        </div>
        <div class="col-md-6">
            <label class="form-label small">Domicilio</label>
            <input name="beneficiarios[@i].Address" value="@d.Address" class="form-control form-control-sm" />
        </div>
        <div class="col-md-3">
            <label class="form-label small">Ciudad</label>
            <input name="beneficiarios[@i].City" value="@d.City" class="form-control form-control-sm" />
        </div>
        <div class="col-md-3">
            <label class="form-label small">País</label>
            <input name="beneficiarios[@i].Country" value="@(string.IsNullOrEmpty(d.Country) ? "Chile" : d.Country)" class="form-control form-control-sm" />
        </div>
        <div class="col-md-3">
            <label class="form-label small">% Participación <span class="text-danger">*</span></label>
            <input name="beneficiarios[@i].ParticipationPercentage" value="@d.ParticipationPercentage" type="number" step="0.01" min="0" max="100" class="form-control form-control-sm" />
        </div>
        <div class="col-md-3 d-flex align-items-end">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="beneficiarios[@i].IsEffectiveControl" value="true"
                       id="ec_@i" @(d.IsEffectiveControl ? "checked" : "") />
                <label class="form-check-label small" for="ec_@i">Control Efectivo</label>
            </div>
        </div>
        <div class="col-md-3 d-flex align-items-end">
            <div class="form-check">
                <input class="form-check-input pep-checkbox" type="checkbox" name="beneficiarios[@i].IsPEP" value="true"
                       id="pep_@i" @(d.IsPEP ? "checked" : "") />
                <label class="form-check-label small" for="pep_@i">¿Es PEP?</label>
            </div>
        </div>
        <div class="col-12 pep-detail" style="display:@(d.IsPEP ? "block" : "none")">
            <label class="form-label small">Detalle PEP <span class="text-danger">*</span></label>
            <input name="beneficiarios[@i].PepDetail" value="@d.PepDetail" class="form-control form-control-sm" placeholder="Cargo, institución, vínculo..." />
        </div>
    </div>
</div>
