<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — FormulariosUAF</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
@{
    var path = Context.Request.Path.Value?.ToLower() ?? "";
    string ActiveIf(string prefix) => path.StartsWith(prefix.ToLower()) ? "active" : "";
}
<body class="@(User.Identity?.IsAuthenticated == true ? "uaf-shell" : "")">

@if (User.Identity?.IsAuthenticated == true)
{
    <aside class="uaf-sidebar" id="uafSidebar">
        <a href="/" class="uaf-brand">
            <span class="uaf-brand-icon"><i class="fa-solid fa-shield-halved"></i></span>
            <span>
                <span class="uaf-brand-name d-block">FormulariosUAF</span>
                <span class="uaf-brand-sub">Declaración Digital Segura</span>
            </span>
        </a>

        <nav class="uaf-nav">
            @if (User.IsInRole("Administrador") || User.IsInRole("Vendedor"))
            {
                <div class="uaf-section-lbl">Solicitudes</div>
                <a href="/Vendedor" class="uaf-nav-link @(path == "/vendedor" || path == "/" ? "active" : "")">
                    <i class="fa-solid fa-briefcase"></i> Mis Solicitudes
                </a>
                <a href="/Vendedor/Crear" class="uaf-nav-link @ActiveIf("/vendedor/crear")">
                    <i class="fa-solid fa-plus-circle"></i> Nueva Solicitud
                </a>
            }
            @if (User.IsInRole("Administrador") || User.IsInRole("Cumplimiento") || User.IsInRole("Revisor"))
            {
                <div class="uaf-section-lbl">Cumplimiento</div>
                <a href="/Cumplimiento" class="uaf-nav-link @ActiveIf("/cumplimiento")">
                    <i class="fa-solid fa-magnifying-glass"></i> Revisión
                </a>
            }
            @if (User.IsInRole("Administrador"))
            {
                <div class="uaf-section-lbl">Administración</div>
                <a href="/Admin/Usuarios" class="uaf-nav-link @ActiveIf("/admin/usuarios")">
                    <i class="fa-solid fa-users-cog"></i> Usuarios
                </a>
                <a href="/Admin" class="uaf-nav-link @(path == "/admin" ? "active" : "")">
                    <i class="fa-solid fa-gears"></i> Administración
                </a>
            }
            <div class="uaf-section-lbl">Cuenta</div>
            <a href="/Interno/Notificaciones" class="uaf-nav-link position-relative @ActiveIf("/interno/notificaciones")">
                <i class="fa-solid fa-bell"></i> Notificaciones
                <span id="notif-badge" class="position-absolute badge rounded-pill bg-danger d-none" style="top:6px;right:10px">0</span>
            </a>
        </nav>

        <div class="uaf-sidebar-footer">
            <div class="dropdown">
                <a href="#" class="uaf-user dropdown-toggle" data-bs-toggle="dropdown">
                    <span class="uaf-avatar"><i class="fa-solid fa-user"></i></span>
                    <span class="uaf-user-name text-truncate" style="max-width:130px">@User.Identity?.Name</span>
                </a>
                <ul class="dropdown-menu dropdown-menu-dark shadow w-100">
                    <li>
                        <form asp-page="/Account/Logout" method="post">
                            <button type="submit" class="dropdown-item">
                                <i class="fa-solid fa-right-from-bracket me-2"></i>Cerrar Sesión
                            </button>
                        </form>
                    </li>
                </ul>
            </div>
        </div>
    </aside>

    <div class="uaf-main">
        <div class="uaf-topbar">
            <button class="btn btn-sm btn-outline-secondary d-lg-none me-3" id="sidebarToggle">
                <i class="fa-solid fa-bars"></i>
            </button>
            <span class="uaf-crumb">@ViewData["Title"]</span>
        </div>
        <div class="uaf-body">
            @RenderBody()
        </div>
    </div>
}
else
{
    <nav class="navbar navbar-dark" style="background-color:#1a2b4a;">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">
                <i class="fa-solid fa-shield-halved me-2"></i>FormulariosUAF
            </a>
        </div>
    </nav>
    <div class="container py-4">
        @RenderBody()
    </div>
}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script>
    document.getElementById('sidebarToggle')?.addEventListener('click', () =>
        document.getElementById('uafSidebar')?.classList.toggle('show'));
</script>

@if (User.Identity?.IsAuthenticated == true)
{
    <!-- SignalR — Fase 2 -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script src="~/js/notifications.js" asp-append-version="true"></script>
}

@await RenderSectionAsync("Scripts", required: false)

</body>
</html>
