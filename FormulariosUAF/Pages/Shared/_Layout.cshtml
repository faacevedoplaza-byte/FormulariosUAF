<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — FormulariosUAF</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

@if (User.Identity?.IsAuthenticated == true)
{
    <div class="d-flex" id="wrapper">
        <nav id="sidebar" class="d-flex flex-column p-3 text-white sidebar-nav">
            <a href="/" class="d-flex align-items-center mb-3 text-white text-decoration-none">
                <i class="fa-solid fa-shield-halved me-2 fs-4"></i>
                <span class="fs-5 fw-bold">FormulariosUAF</span>
            </a>
            <hr />
            <ul class="nav nav-pills flex-column mb-auto">
                @if (User.IsInRole("Administrador") || User.IsInRole("Vendedor"))
                {
                    <li class="nav-item mb-1">
                        <a href="/Vendedor" class="nav-link text-white">
                            <i class="fa-solid fa-briefcase me-2"></i> Mis Solicitudes
                        </a>
                    </li>
                    <li class="nav-item mb-1">
                        <a href="/Vendedor/Crear" class="nav-link text-white">
                            <i class="fa-solid fa-plus-circle me-2"></i> Nueva Solicitud
                        </a>
                    </li>
                }
                @if (User.IsInRole("Administrador") || User.IsInRole("Cumplimiento"))
                {
                    <li class="nav-item mb-1">
                        <a href="/Cumplimiento" class="nav-link text-white">
                            <i class="fa-solid fa-magnifying-glass me-2"></i> Revisión
                        </a>
                    </li>
                }
                @if (User.IsInRole("Administrador"))
                {
                    <li class="nav-item mb-1">
                        <a href="/Admin" class="nav-link text-white">
                            <i class="fa-solid fa-gears me-2"></i> Administración
                        </a>
                    </li>
                }
            </ul>
            <hr />
            <div class="dropdown">
                <a href="#" class="d-flex align-items-center text-white text-decoration-none dropdown-toggle" data-bs-toggle="dropdown">
                    <i class="fa-solid fa-circle-user me-2 fs-5"></i>
                    <strong class="text-truncate" style="max-width:140px">@User.Identity?.Name</strong>
                </a>
                <ul class="dropdown-menu dropdown-menu-dark text-small shadow">
                    <li>
                        <form asp-page="/Account/Logout" method="post">
                            <button type="submit" class="dropdown-item">
                                <i class="fa-solid fa-right-from-bracket me-2"></i>Cerrar Sesión
                            </button>
                        </form>
                    </li>
                </ul>
            </div>
        </nav>

        <div id="page-content-wrapper" class="w-100">
            <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom px-4">
                <button class="btn btn-sm btn-outline-secondary" id="sidebarToggle">
                    <i class="fa-solid fa-bars"></i>
                </button>
                <span class="ms-3 text-muted small">@ViewData["Title"]</span>
            </nav>
            <div class="container-fluid p-4">
                @RenderBody()
            </div>
        </div>
    </div>
}
else
{
    <nav class="navbar navbar-dark" style="background-color:#1a3a5c;">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">
                <i class="fa-solid fa-shield-halved me-2"></i>FormulariosUAF
            </a>
        </div>
    </nav>
    <div class="container py-4">
        @RenderBody()
    </div>
}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)

</body>
</html>
