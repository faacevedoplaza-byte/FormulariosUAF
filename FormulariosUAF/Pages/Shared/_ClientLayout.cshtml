<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Declaración UAF</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">

<nav class="navbar navbar-dark" style="background-color:#1a3a5c;">
    <div class="container">
        <span class="navbar-brand fw-bold">
            <i class="fa-solid fa-shield-halved me-2"></i>
            @(ViewData["CompanyName"] ?? "FormulariosUAF")
        </span>
        <span class="text-white-50 small">Declaración Digital Segura</span>
    </div>
</nav>

@if (ViewData["CurrentStep"] != null)
{
    var step = (int)ViewData["CurrentStep"]!;
    var steps = new[] { "Empresa", "Beneficiarios", "Control Efectivo", "Dec. PEP", "Declarante", "Adjuntos", "Revisión" };
    <div class="container mt-3">
        <div class="card shadow-sm border-0 mb-3">
            <div class="card-body pb-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <small class="text-muted">Paso @step de 7: <strong>@(step <= steps.Length ? steps[step - 1] : "")</strong></small>
                    <small class="text-muted">@(step * 100 / 7)% completado</small>
                </div>
                <div class="progress" style="height: 8px;">
                    <div class="progress-bar bg-primary" style="width: @(step * 100 / 7)%"></div>
                </div>
                <div class="d-none d-md-flex justify-content-between mt-2">
                    @for (int i = 0; i < steps.Length; i++)
                    {
                        <small class="@(i + 1 < step ? "text-success fw-bold" : i + 1 == step ? "text-primary fw-bold" : "text-muted")">
                            @if (i + 1 < step) { <i class="fa-solid fa-check-circle"></i> }
                            else if (i + 1 == step) { <i class="fa-solid fa-circle-dot"></i> }
                            else { <i class="fa-regular fa-circle"></i> }
                            @steps[i]
                        </small>
                    }
                </div>
            </div>
        </div>
    </div>
}

<div class="container py-3">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-9">
            @RenderBody()
        </div>
    </div>
</div>

<footer class="py-3 mt-4 border-top bg-white">
    <div class="container text-center text-muted small">
        <i class="fa-solid fa-lock me-1"></i>
        Conexión segura. La información declarada será utilizada para procesos de debida diligencia y conocimiento del cliente.
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)

</body>
</html>
