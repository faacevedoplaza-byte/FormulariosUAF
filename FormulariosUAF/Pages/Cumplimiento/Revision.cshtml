@page "{id:guid}"
@model FormulariosUAF.Pages.Cumplimiento.RevisionModel
@{
    ViewData["Title"] = $"Revisión {Model.Request?.RequestNumber}";
    var req = Model.Request;
}

@if (req is null)
{
    <div class="alert alert-danger">Solicitud no encontrada.</div>
    return;
}

<div class="mb-3">
    <a href="/Cumplimiento" class="btn btn-sm btn-outline-secondary">
        <i class="fa-solid fa-arrow-left me-1"></i>Volver
    </a>
</div>

<div class="row g-4">
    <div class="col-lg-8">

        <!-- Empresa -->
        @if (req.LegalEntityDeclaration is { } led)
        {
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header fw-bold bg-light">
                    <i class="fa-solid fa-building me-2"></i>Persona Jurídica
                </div>
                <div class="card-body">
                    <div class="row g-2 small">
                        <div class="col-md-6"><strong>RUT:</strong> @led.RUT</div>
                        <div class="col-md-6"><strong>Razón Social:</strong> @led.BusinessName</div>
                        <div class="col-md-6"><strong>Domicilio:</strong> @led.Address</div>
                        <div class="col-md-6"><strong>Ciudad:</strong> @led.City</div>
                        <div class="col-md-6"><strong>País:</strong> @led.CountryOfIncorporation</div>
                        <div class="col-md-6"><strong>Tipo Entidad:</strong> @led.EntityType.ToDisplayString()</div>
                        <div class="col-md-6"><strong>Representante Legal:</strong> @led.LegalRepresentativeName</div>
                        <div class="col-md-6"><strong>RUT Rep. Legal:</strong> @led.LegalRepresentativeIdNumber</div>
                    </div>
                </div>
            </div>
        }

        <!-- Personas declaradas (nuevo modelo) -->
        @if (req.DeclaredPersons.Any())
        {
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header fw-bold bg-light">
                    <i class="fa-solid fa-users me-2"></i>Personas Declaradas (@req.DeclaredPersons.Count)
                    @if (req.DeclaredPersons.Any(p => p.IsPEP))
                    {
                        <span class="badge bg-danger ms-2">Incluye PEP</span>
                    }
                    @if (req.DeclaredPersons.Any(p => p.IsEffectiveController))
                    {
                        <span class="badge bg-warning text-dark ms-1">Control Efectivo</span>
                    }
                </div>
                <div class="card-body p-0">
                    <table class="table table-sm mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Nombre</th><th>RUT/ID</th><th>Tipo Relación</th>
                                <th>% Part.</th><th>PEP</th><th>Control</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in req.DeclaredPersons.OrderBy(x => x.SortOrder))
                            {
                                <tr class="@(p.IsPEP ? "table-danger" : p.IsEffectiveController ? "table-warning" : "")">
                                    <td>@p.FullName</td>
                                    <td><small>@p.IdNumber</small></td>
                                    <td><span class="badge bg-secondary">@p.RelationshipType.ToDisplayString()</span></td>
                                    <td>@p.ParticipationPercentage.ToString("F1")%</td>
                                    <td>
                                        @if (p.IsPEP)
                                        {
                                            <span class="badge bg-danger">PEP</span>
                                            <small class="d-block text-muted">@p.PepType?.ToDisplayString()</small>
                                        }
                                        else { <span class="text-muted small">No</span> }
                                    </td>
                                    <td>
                                        @if (p.IsEffectiveController)
                                        {
                                            <i class="fa-solid fa-circle-check text-warning" title="@p.EffectiveControlDescription"></i>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <!-- Análisis carpeta tributaria -->
        @if (req.TaxFolderAnalysis is { } tax)
        {
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header fw-bold bg-light">
                    <i class="fa-solid fa-folder-open me-2"></i>Análisis Carpeta Tributaria
                    @if (!tax.WasReadable)
                    {
                        <span class="badge bg-danger ms-2">No legible</span>
                    }
                    else if (tax.Alerts.Any(a => !a.IsResolved))
                    {
                        <span class="badge bg-warning text-dark ms-2">@tax.Alerts.Count(a => !a.IsResolved) alerta(s)</span>
                    }
                    else
                    {
                        <span class="badge bg-success ms-2">Sin alertas</span>
                    }
                </div>
                <div class="card-body small">
                    @if (tax.WasReadable)
                    {
                        <div class="row g-2 mb-2">
                            <div class="col-md-4"><strong>RUT:</strong> @(tax.ExtractedRut ?? "—")</div>
                            <div class="col-md-8"><strong>Razón Social:</strong> @(tax.ExtractedBusinessName ?? "—")</div>
                            <div class="col-md-8"><strong>Domicilio:</strong> @(tax.ExtractedAddress ?? "—")</div>
                            <div class="col-md-4"><strong>Analizado:</strong> @tax.AnalyzedAt.ToString("dd/MM/yyyy HH:mm")</div>
                        </div>
                    }
                    @if (tax.Alerts.Any())
                    {
                        <ul class="list-unstyled mb-0">
                            @foreach (var alert in tax.Alerts)
                            {
                                <li class="@(alert.Severity == "Error" ? "text-danger" : alert.Severity == "Warning" ? "text-warning" : "text-muted") mb-1">
                                    <i class="fa-solid fa-circle-exclamation me-1"></i>
                                    <small>@alert.Message</small>
                                    @if (alert.IsResolved)
                                    {
                                        <span class="badge bg-success ms-1">Resuelta</span>
                                    }
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        }

        <!-- Declarante -->
        @if (req.Declarant is { } dec)
        {
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header fw-bold bg-light">
                    <i class="fa-solid fa-user-pen me-2"></i>Declarante y Firma
                </div>
                <div class="card-body small">
                    <div class="row g-2">
                        <div class="col-md-6"><strong>Nombre:</strong> @dec.FullName</div>
                        <div class="col-md-6"><strong>RUT/ID:</strong> @dec.IdNumber</div>
                        <div class="col-md-6"><strong>Cargo/Relación:</strong> @dec.RelationshipWithLegalEntity</div>
                        <div class="col-md-6"><strong>Ciudad:</strong> @dec.City</div>
                        @if (dec.SignatureFullName is not null)
                        {
                            <div class="col-md-6"><strong>Firma:</strong> @dec.SignatureFullName</div>
                            <div class="col-md-6"><strong>Fecha firma:</strong> @dec.SignatureDateTime?.ToString("dd/MM/yyyy HH:mm")</div>
                            <div class="col-md-6"><strong>IP:</strong> @dec.SignatureIpAddress</div>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- Documentos -->
        @if (req.Documents.Any())
        {
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header fw-bold bg-light">
                    <i class="fa-solid fa-folder-open me-2"></i>Documentos
                </div>
                <div class="card-body p-0">
                    <table class="table table-sm mb-0">
                        <thead class="table-light">
                            <tr><th>Tipo</th><th>Archivo</th><th>Fecha</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var doc in req.Documents.Where(d => d.IsActive))
                            {
                                <tr>
                                    <td><small>@doc.DocumentType.ToDisplayString()</small></td>
                                    <td><small class="font-monospace">@doc.OriginalFileName</small></td>
                                    <td><small>@doc.UploadedAt.ToString("dd/MM/yyyy")</small></td>
                                    <td>
                                        <a href="/Cumplimiento/DescargarDoc/@doc.Id" class="btn btn-sm btn-outline-secondary">
                                            <i class="fa-solid fa-download"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>

    <!-- Panel acciones -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm mb-4 sticky-top" style="top:1rem">
            <div class="card-header fw-bold">
                <i class="fa-solid fa-gavel me-2"></i>Decisión
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <span class="badge @req.Status.ToBadgeClass() fs-6 mb-2">@req.Status.ToDisplayString()</span>
                </div>

                <form method="post">
                    <input type="hidden" name="RequestId" value="@req.Id" />
                    <div class="mb-3">
                        <label class="form-label">Observación / Motivo</label>
                        <textarea name="Observacion" class="form-control" rows="3" placeholder="Comentario para el cliente o registro interno..."></textarea>
                    </div>
                    <div class="d-grid gap-2">
                        <button type="submit" asp-page-handler="Aprobar" class="btn btn-success">
                            <i class="fa-solid fa-check me-1"></i>Aprobar
                        </button>
                        <button type="submit" asp-page-handler="SolicitarCorreccion" class="btn btn-warning">
                            <i class="fa-solid fa-rotate-left me-1"></i>Solicitar Corrección al Cliente
                        </button>
                        <button type="submit" asp-page-handler="Observar" class="btn btn-outline-warning">
                            <i class="fa-solid fa-comment-dots me-1"></i>Observar (Interno)
                        </button>
                        <button type="submit" asp-page-handler="Rechazar" class="btn btn-danger">
                            <i class="fa-solid fa-xmark me-1"></i>Rechazar
                        </button>
                    </div>
                </form>

                <hr />
                <a href="/Cumplimiento/ExportarZip/@req.Id" class="btn btn-outline-dark w-100 mb-2">
                    <i class="fa-solid fa-file-zipper me-1"></i>Exportar Expediente ZIP
                </a>

                @if (req.Status == FormulariosUAF.Models.Enums.RequestStatus.Aprobada)
                {
                    <hr />
                    <a href="/Cumplimiento/DescargarPdf/@req.Id" class="btn btn-outline-primary w-100">
                        <i class="fa-solid fa-file-pdf me-1"></i>Descargar PDF
                    </a>
                }
            </div>
        </div>

        <!-- Historial -->
        <div class="card border-0 shadow-sm">
            <div class="card-header fw-bold"><i class="fa-solid fa-clock-rotate-left me-2"></i>Historial</div>
            <div class="card-body p-0">
                <ul class="list-group list-group-flush">
                    @foreach (var h in req.StatusHistory.OrderByDescending(x => x.ChangedAt).Take(8))
                    {
                        <li class="list-group-item py-2 small">
                            <div class="d-flex justify-content-between">
                                <span class="badge @h.NewStatus.ToBadgeClass()">@h.NewStatus.ToDisplayString()</span>
                                <span class="text-muted">@h.ChangedAt.ToString("dd/MM HH:mm")</span>
                            </div>
                            @if (!string.IsNullOrEmpty(h.Notes))
                            { <div class="text-muted mt-1">@h.Notes</div> }
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>
