@page
@model FormulariosUAF.Pages.Cumplimiento.IndexModel
@{
    ViewData["Title"] = "Panel de Revisión";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0"><i class="fa-solid fa-magnifying-glass me-2 text-primary"></i>Panel de Cumplimiento</h4>
</div>

<!-- Estadísticas -->
<div class="row g-3 mb-4 row-cols-2 row-cols-md-3 row-cols-xl-6">
    <div class="col">
        <div class="card border-0 shadow-sm text-center">
            <div class="card-body py-3">
                <div class="fs-3 fw-bold text-warning">@Model.Stats.Pendientes</div>
                <small class="text-muted">Pendientes de Revisión</small>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card border-0 shadow-sm text-center">
            <div class="card-body py-3">
                <div class="fs-3 fw-bold text-success">@Model.Stats.Aprobadas</div>
                <small class="text-muted">Aprobadas (mes)</small>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card border-0 shadow-sm text-center">
            <div class="card-body py-3">
                <div class="fs-3 fw-bold text-danger">@Model.Stats.Observadas</div>
                <small class="text-muted">Observadas</small>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card border-0 shadow-sm text-center">
            <div class="card-body py-3">
                <div class="fs-3 fw-bold text-danger">@Model.Stats.Rechazadas</div>
                <small class="text-muted">Rechazadas</small>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card border-0 shadow-sm text-center">
            <div class="card-body py-3">
                <div class="fs-3 fw-bold text-dark">@Model.Stats.Vencidas</div>
                <small class="text-muted">Vencidas</small>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card border-0 shadow-sm text-center">
            <div class="card-body py-3">
                <div class="fs-3 fw-bold text-info">@Model.Stats.ConPEP</div>
                <small class="text-muted">Con PEP declarado</small>
            </div>
        </div>
    </div>
</div>

<!-- Filtros -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-2">
            <div class="col-md-3">
                <input name="rut" value="@Model.FilterRut" class="form-control form-control-sm rut-input" placeholder="RUT" />
            </div>
            <div class="col-md-3">
                <select name="estado" class="form-select form-select-sm">
                    <option value="">Todos los estados</option>
                    @foreach (var s in new[] { FormulariosUAF.Models.Enums.RequestStatus.CompletadaPorCliente, FormulariosUAF.Models.Enums.RequestStatus.EnRevision, FormulariosUAF.Models.Enums.RequestStatus.Observada, FormulariosUAF.Models.Enums.RequestStatus.CorregidaPorCliente, FormulariosUAF.Models.Enums.RequestStatus.Rechazada, FormulariosUAF.Models.Enums.RequestStatus.Vencida })
                    {
                        <option value="@((int)s)" selected="@(Model.FilterEstado == (int)s)">@s.ToDisplayString()</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-secondary btn-sm w-100">
                    <i class="fa-solid fa-filter me-1"></i>Filtrar
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Tabla -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Folio</th><th>RUT</th><th>Razón Social</th><th>Estado</th>
                        <th class="text-center">PEP</th><th>Completada</th><th>Vendedor</th><th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Requests.Any())
                    {
                        <tr><td colspan="8" class="text-center text-muted py-4">No hay solicitudes para mostrar</td></tr>
                    }
                    @foreach (var req in Model.Requests)
                    {
                        <tr>
                            <td><span class="font-monospace small">@req.RequestNumber</span></td>
                            <td>@req.Client.RUT</td>
                            <td>@req.Client.BusinessName</td>
                            <td><span class="badge @req.Status.ToBadgeClass()">@req.Status.ToDisplayString()</span></td>
                            <td class="text-center">
                                @if (req.BeneficialOwners.Any(b => b.IsPEP) || req.PepDeclaration?.DeclaresPEP == true)
                                {
                                    <span class="badge bg-danger"><i class="fa-solid fa-exclamation-triangle me-1"></i>PEP</span>
                                }
                                else { <span class="text-muted">—</span> }
                            </td>
                            <td><small class="text-muted">@(req.CompletedAt?.ToString("dd/MM/yyyy") ?? "—")</small></td>
                            <td><small>@req.VendorUser?.FullName</small></td>
                            <td>
                                <a href="/Cumplimiento/Revision/@req.Id" class="btn btn-sm btn-primary">
                                    <i class="fa-solid fa-eye me-1"></i>Revisar
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
