@page
@model FormulariosUAF.Pages.Admin.Usuarios.EditarModel
@{
    ViewData["Title"] = "Editar Usuario";
}

<div class="row">
    <div class="col-lg-6">
        <a href="/Admin/Usuarios" class="btn btn-sm btn-outline-secondary mb-3">
            <i class="fa-solid fa-arrow-left me-1"></i>Volver
        </a>

        <div class="card border-0 shadow-sm">
            <div class="card-header fw-bold">
                <i class="fa-solid fa-user-pen me-2 text-primary"></i>Editar: @Model.Input.Email
            </div>
            <div class="card-body p-4">
                <form method="post">
                    <input type="hidden" asp-for="Input.UserId" />
                    <div class="mb-3">
                        <label asp-for="Input.Login" class="form-label">Login <span class="text-danger">*</span></label>
                        <input asp-for="Input.Login" class="form-control" placeholder="Ej: jperez" />
                        <div class="form-text">Con este valor inicia sesión el usuario.</div>
                        <span asp-validation-for="Input.Login" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.Rut" class="form-label">RUT <span class="text-danger">*</span></label>
                        <input asp-for="Input.Rut" class="form-control rut-input" placeholder="12.345.678-9" />
                        <span asp-validation-for="Input.Rut" class="text-danger small"></span>
                    </div>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="Input.Nombre" class="form-label">Nombre <span class="text-danger">*</span></label>
                            <input asp-for="Input.Nombre" class="form-control name-input" placeholder="Nombre" />
                            <span asp-validation-for="Input.Nombre" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="Input.ApellidoPaterno" class="form-label">Apellido paterno <span class="text-danger">*</span></label>
                            <input asp-for="Input.ApellidoPaterno" class="form-control name-input" placeholder="Apellido paterno" />
                            <span asp-validation-for="Input.ApellidoPaterno" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="Input.ApellidoMaterno" class="form-label">Apellido materno</label>
                            <input asp-for="Input.ApellidoMaterno" class="form-control name-input" placeholder="Apellido materno" />
                            <span asp-validation-for="Input.ApellidoMaterno" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label">Email <span class="text-danger">*</span></label>
                        <input asp-for="Input.Email" type="email" class="form-control" placeholder="usuario@empresa.cl" />
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.Role" class="form-label">Rol <span class="text-danger">*</span></label>
                        <select asp-for="Input.Role" class="form-select">
                            @foreach (var role in FormulariosUAF.Data.SeedData.Roles)
                            {
                                <option value="@role">@role</option>
                            }
                        </select>
                        <span asp-validation-for="Input.Role" class="text-danger small"></span>
                    </div>
                    <div class="mb-3 form-check">
                        <input asp-for="Input.IsActive" class="form-check-input" type="checkbox" />
                        <label asp-for="Input.IsActive" class="form-check-label">Usuario activo</label>
                    </div>

                    <hr />
                    <h6 class="text-muted">Cambiar Contraseña <small>(dejar en blanco para no cambiar)</small></h6>
                    <div class="mb-3">
                        <label asp-for="Input.NewPassword" class="form-label">Nueva contraseña</label>
                        <input asp-for="Input.NewPassword" type="password" class="form-control" />
                        <span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="Input.ConfirmNewPassword" class="form-label">Confirmar nueva contraseña</label>
                        <input asp-for="Input.ConfirmNewPassword" type="password" class="form-control" />
                        <span asp-validation-for="Input.ConfirmNewPassword" class="text-danger small"></span>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="alert alert-danger small">@Model.ErrorMessage</div>
                    }

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="fa-solid fa-floppy-disk me-1"></i>Guardar Cambios
                        </button>
                        <a href="/Admin/Usuarios" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
