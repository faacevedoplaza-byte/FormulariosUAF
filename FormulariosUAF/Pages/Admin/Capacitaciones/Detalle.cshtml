@page "{id:int}"
@model FormulariosUAF.Pages.Admin.Capacitaciones.DetalleModel
@using static FormulariosUAF.Pages.Admin.Capacitaciones.DetalleModel
@{
    var cap = Model.Capacitacion;
    ViewData["Title"] = cap.Titulo;
    var cuenta = Enum.GetValues<Verificacion>().ToDictionary(v => v, v => Model.Asistentes.Count(f => f.Verificacion == v));
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="fa-solid fa-circle-check me-2"></i>@TempData["Success"] <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["Error"] <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-start mb-3 flex-wrap gap-2">
    <div>
        <a asp-page="Index" class="small text-muted text-decoration-none"><i class="fa-solid fa-arrow-left me-1"></i>Capacitaciones</a>
        <h4 class="fw-bold mb-1 mt-1">
            @cap.Titulo
            <span id="capEstadoVivo" class="gs-vivo align-middle ms-2" title="Conectando…"><i></i><span>Conectando…</span></span>
        </h4>
        <div class="text-muted small">
            <i class="fa-regular fa-calendar me-1"></i>@cap.Fecha.ToString("dd/MM/yyyy HH:mm")
            @if (!string.IsNullOrWhiteSpace(cap.Lugar)) { <span> · <i class="fa-solid fa-location-dot me-1"></i>@cap.Lugar</span> }
            @if (!string.IsNullOrWhiteSpace(cap.Relator)) { <span> · <i class="fa-solid fa-user-tie me-1"></i>@cap.Relator</span> }
        </div>
    </div>
    @* Los id cap* se reemplazan en vivo (vista-en-vivo.js); el enlace y el QR no. *@
    <div class="d-flex gap-2" id="capAcciones">
        <a asp-page-handler="Csv" asp-route-id="@cap.Id" class="btn btn-outline-secondary btn-sm"><i class="fa-solid fa-file-csv me-1"></i>Descargar lista</a>
        <form method="post" asp-page-handler="AlternarRegistro" asp-route-id="@cap.Id">
            @if (cap.RegistroAbierto)
            {
                <button class="btn btn-outline-danger btn-sm" onclick="return confirm('¿Cerrar el registro? El enlace dejará de aceptar asistencias.')"><i class="fa-solid fa-lock me-1"></i>Cerrar registro</button>
            }
            else
            {
                <button class="btn btn-outline-success btn-sm"><i class="fa-solid fa-lock-open me-1"></i>Reabrir registro</button>
            }
        </form>
        <button type="button" class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#modalEliminarCap">
            <i class="fa-solid fa-trash me-1"></i>Eliminar capacitación
        </button>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header fw-bold d-flex justify-content-between">
                <span><i class="fa-solid fa-link me-2 text-primary"></i>Enlace para los asistentes</span>
                <span id="capEstadoRegistro">
                    @if (cap.RegistroAbierto)
                    {
                        <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle">Registro abierto</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle">Registro cerrado</span>
                    }
                </span>
            </div>
            <div class="card-body">
                <div class="input-group mb-2">
                    <input id="enlace" class="form-control font-monospace small" value="@Model.Enlace" readonly onclick="this.select()" />
                    <button class="btn btn-primary" type="button" id="btnCopiar"><i class="fa-regular fa-copy me-1"></i>Copiar</button>
                    <a class="btn btn-outline-secondary" href="@Model.Enlace" target="_blank" rel="noopener"><i class="fa-solid fa-up-right-from-square"></i></a>
                </div>
                <div class="small text-muted">
                    Envía este enlace por correo o WhatsApp, o muestra el código QR en la sala. No hace falta tener cuenta en el sistema.
                    Cada RUT puede registrarse una sola vez.
                </div>

                <div class="row g-2 mt-3 text-center" id="capContadores">
                    <div class="col-6 col-md-3"><div class="border rounded p-2"><div class="fs-4 fw-bold">@Model.Asistentes.Count</div><div class="small text-muted">Asistentes</div></div></div>
                    @foreach (var v in Enum.GetValues<Verificacion>())
                    {
                        var (texto, color, ayuda) = Info(v);
                        <div class="col-6 col-md-3"><div class="border rounded p-2" title="@ayuda"><div class="fs-4 fw-bold text-@color">@cuenta[v]</div><div class="small text-muted">@texto</div></div></div>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header fw-bold"><i class="fa-solid fa-qrcode me-2 text-primary"></i>Código QR</div>
            <div class="card-body d-flex flex-column align-items-center justify-content-center">
                <div id="qr" class="bg-white p-2 rounded"></div>
                <button type="button" class="btn btn-link btn-sm mt-1" id="btnQrGrande"><i class="fa-solid fa-expand me-1"></i>Pantalla completa</button>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm mb-3" id="capAsistentes">
    <div class="card-header fw-bold"><i class="fa-solid fa-users me-2 text-primary"></i>Asistentes registrados (@Model.Asistentes.Count)</div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 small">
            <thead class="table-light">
                <tr><th>Nombre</th><th>RUT</th><th>Correo</th><th>Teléfono</th><th>Empresa</th><th>Sucursal / cargo</th><th>Registro</th><th>Verificación con usuarios</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var f in Model.Asistentes)
                {
                    var (texto, color, ayuda) = Info(f.Verificacion);
                    <tr data-asistencia="@f.A.Id">
                        <td class="fw-semibold">@f.A.NombreCompleto</td>
                        <td class="text-nowrap">@FormatoRut(f.A.Rut)</td>
                        <td>@f.A.Email</td>
                        <td class="text-muted">@(f.A.Telefono ?? "—")</td>
                        <td>@(f.A.Empresa?.Nombre ?? "—")</td>
                        <td class="text-muted">@(string.Join(" · ", new[] { f.A.Sucursal, f.A.Cargo }.Where(s => !string.IsNullOrWhiteSpace(s))) is var cs && cs != "" ? cs : "—")</td>
                        <td class="text-muted text-nowrap" title="Aceptó: @(f.A.AceptaAsistencia ? "Sí" : "No") · IP @f.A.IpAddress">
                            @if (f.A.AceptaAsistencia) { <i class="fa-solid fa-square-check text-success me-1"></i> }
                            @f.A.FechaRegistro.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                        </td>
                        <td>
                            <span class="badge bg-@color-subtle text-@color-emphasis border border-@color-subtle" title="@ayuda">@texto</span>
                            @if (f.Usuario is not null)
                            {
                                <div class="text-muted mt-1">
                                    <a asp-page="/Admin/Usuarios/Editar" asp-route-id="@f.Usuario.Id" class="text-decoration-none">@f.Usuario.Nombre</a>
                                    @if (f.Verificacion != Verificacion.Coincide)
                                    {
                                        <span>· @(f.Verificacion == Verificacion.SoloCorreo ? "RUT en sistema: " + (string.IsNullOrEmpty(f.Usuario.Rut) ? "sin RUT" : FormatoRut(f.Usuario.Rut)) : "correo en sistema: " + (f.Usuario.Email ?? "—"))</span>
                                    }
                                    @if (!f.Usuario.Activo) { <span class="badge bg-danger-subtle text-danger-emphasis ms-1">Inactivo</span> }
                                </div>
                            }
                        </td>
                        <td class="text-end">
                            <button type="button" class="btn btn-sm btn-outline-danger py-0" title="Eliminar registro (p. ej. si es un error o un duplicado)"
                                    data-bs-toggle="modal" data-bs-target="#modalEliminarAsistente"
                                    data-asistencia-id="@f.A.Id" data-nombre="@f.A.NombreCompleto" data-rut="@FormatoRut(f.A.Rut)"
                                    data-fecha="@f.A.FechaRegistro.ToLocalTime().ToString("dd/MM/yyyy HH:mm")">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
                @if (!Model.Asistentes.Any())
                {
                    <tr><td colspan="9" class="text-center text-muted py-4">Todavía nadie registra su asistencia.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="card border-0 shadow-sm" id="capSinRegistro">
    <div class="card-header fw-bold d-flex justify-content-between align-items-center">
        <span><i class="fa-solid fa-user-clock me-2 text-primary"></i>Usuarios activos del sistema sin registro (@Model.SinRegistro.Count)</span>
        <button class="btn btn-sm btn-outline-secondary py-0" type="button" data-bs-toggle="collapse" data-bs-target="#sinRegistro">Mostrar / ocultar</button>
    </div>
    <div class="collapse" id="sinRegistro">
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0 small">
                <thead class="table-light"><tr><th>Usuario</th><th>Login</th><th>RUT</th><th>Correo</th><th>Rol</th></tr></thead>
                <tbody>
                    @foreach (var u in Model.SinRegistro)
                    {
                        <tr>
                            <td>@u.Nombre</td>
                            <td class="text-muted">@u.UserName</td>
                            <td class="text-nowrap">@(string.IsNullOrEmpty(u.Rut) ? "—" : FormatoRut(u.Rut))</td>
                            <td>@u.Email</td>
                            <td class="text-muted">@(u.Roles == "" ? "—" : u.Roles)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@* Modales fuera de los contenedores en vivo: si llega un registro mientras están abiertos, no se reemplazan. *@
<div class="modal fade" id="modalEliminarAsistente" tabindex="-1" aria-labelledby="modalEliminarAsistenteTitulo" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form method="post" asp-page-handler="Eliminar" asp-route-id="@cap.Id" class="modal-content">
            <input type="hidden" name="asistenciaId" id="elimAsistenciaId" />
            <div class="modal-header">
                <h5 class="modal-title" id="modalEliminarAsistenteTitulo"><i class="fa-solid fa-user-xmark me-2 text-danger"></i>Eliminar registro de asistencia</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p class="mb-2">¿Eliminar el registro de esta persona?</p>
                <div class="border rounded p-3 bg-light mb-3">
                    <div class="fw-bold" id="elimAsistenteNombre"></div>
                    <div class="small text-muted">RUT <span id="elimAsistenteRut"></span> · registrado el <span id="elimAsistenteFecha"></span></div>
                </div>
                <p class="small text-muted mb-0">
                    Úsalo para errores o registros de prueba. La persona podrá volver a registrarse con el enlace mientras el registro esté abierto.
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-danger" id="elimAsistenteBoton"><i class="fa-solid fa-trash me-1"></i>Eliminar registro</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="modalEliminarCap" tabindex="-1" aria-labelledby="modalEliminarCapTitulo" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form method="post" asp-page-handler="EliminarCapacitacion" asp-route-id="@cap.Id" class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="modalEliminarCapTitulo"><i class="fa-solid fa-triangle-exclamation me-2"></i>Eliminar capacitación</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p class="mb-2">Vas a eliminar <strong>«@cap.Titulo»</strong> y <strong>todos sus registros de asistencia (<span id="elimCantidad">@Model.Asistentes.Count</span>)</strong>.</p>
                <ul class="small text-muted mb-3">
                    <li>No se puede deshacer.</li>
                    <li>El enlace y el código QR dejarán de funcionar.</li>
                    <li>Si necesitas la lista, <a asp-page-handler="Csv" asp-route-id="@cap.Id">descárgala antes</a>.</li>
                </ul>
                <label for="elimConfirmacion" class="form-label small">Para confirmar, escribe <strong>@PalabraConfirmacion</strong>:</label>
                <input id="elimConfirmacion" name="confirmacion" class="form-control" autocomplete="off" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-danger" id="elimBoton" disabled><i class="fa-solid fa-trash me-1"></i>Eliminar definitivamente</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <script src="~/js/vista-en-vivo.js" asp-append-version="true"></script>
    <script>
        (function () {
            var enlace = document.getElementById('enlace').value;
            if (window.QRCode) new QRCode(document.getElementById('qr'), { text: enlace, width: 180, height: 180, correctLevel: QRCode.CorrectLevel.M });

            document.getElementById('btnCopiar').addEventListener('click', function () {
                var btn = this;
                var listo = function () { btn.innerHTML = '<i class="fa-solid fa-check me-1"></i>Copiado'; setTimeout(function () { btn.innerHTML = '<i class="fa-regular fa-copy me-1"></i>Copiar'; }, 2000); };
                if (navigator.clipboard && window.isSecureContext) navigator.clipboard.writeText(enlace).then(listo);
                else { var i = document.getElementById('enlace'); i.select(); document.execCommand('copy'); listo(); }
            });

            // QR grande para proyectar en la sala
            document.getElementById('btnQrGrande').addEventListener('click', function () {
                var capa = document.createElement('div');
                capa.style.cssText = 'position:fixed;inset:0;background:#fff;z-index:2000;display:flex;flex-direction:column;align-items:center;justify-content:center;cursor:pointer';
                capa.innerHTML = '<h3 class="fw-bold mb-1"></h3><div class="text-muted mb-4">Escanea para registrar tu asistencia</div><div id="qrGrande"></div><div class="text-muted small mt-4">Clic o Esc para cerrar</div>';
                capa.querySelector('h3').textContent = @Json.Serialize(cap.Titulo);
                document.body.appendChild(capa);
                var lado = Math.min(window.innerWidth, window.innerHeight) * 0.6;
                if (window.QRCode) new QRCode(capa.querySelector('#qrGrande'), { text: enlace, width: lado, height: lado, correctLevel: QRCode.CorrectLevel.M });
                var cerrar = function () { capa.remove(); document.removeEventListener('keydown', esc); };
                var esc = function (e) { if (e.key === 'Escape') cerrar(); };
                capa.addEventListener('click', cerrar);
                document.addEventListener('keydown', esc);
            });

            // En vivo: cuando alguien se registra en el enlace (o se elimina un registro, o se abre/cierra el
            // registro) se recargan la tabla, los contadores y los botones, sin tocar el enlace ni el QR.
            var filas = function () { return Array.from(document.querySelectorAll('#capAsistentes tr[data-asistencia]')); };
            var vistos = new Set(filas().map(function (tr) { return tr.dataset.asistencia; }));
            uafVivo({
                contenedores: ['capAcciones', 'capEstadoRegistro', 'capContadores', 'capAsistentes', 'capSinRegistro'],
                eventos: ['CapacitacionCambiada'],
                estado: 'capEstadoVivo',
                seguir: function (hub) { return hub.invoke('SeguirCapacitaciones'); },
                filtro: function (id) { return id === @cap.Id; },
                alActualizar: function () {
                    filas().forEach(function (tr) {
                        if (!vistos.has(tr.dataset.asistencia)) tr.classList.add('cap-nuevo');
                    });
                    vistos = new Set(filas().map(function (tr) { return tr.dataset.asistencia; }));
                }
            });

            // Eliminar un registro: el modal toma los datos del botón de la fila que lo abrió.
            var modalAsistente = document.getElementById('modalEliminarAsistente');
            modalAsistente.addEventListener('show.bs.modal', function (e) {
                var d = e.relatedTarget.dataset;
                document.getElementById('elimAsistenciaId').value = d.asistenciaId;
                document.getElementById('elimAsistenteNombre').textContent = d.nombre;
                document.getElementById('elimAsistenteRut').textContent = d.rut;
                document.getElementById('elimAsistenteFecha').textContent = d.fecha;
                var b = document.getElementById('elimAsistenteBoton');
                b.disabled = false;
                b.innerHTML = '<i class="fa-solid fa-trash me-1"></i>Eliminar registro';
            });
            modalAsistente.querySelector('form').addEventListener('submit', function () {
                var b = document.getElementById('elimAsistenteBoton');
                b.disabled = true;
                b.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Eliminando…';
            });

            // Eliminar: el botón se habilita solo al escribir la palabra; la cantidad se toma al abrir (pudo cambiar en vivo).
            var modal = document.getElementById('modalEliminarCap');
            var confirmacion = document.getElementById('elimConfirmacion');
            var botonEliminar = document.getElementById('elimBoton');
            confirmacion.addEventListener('input', function () {
                botonEliminar.disabled = confirmacion.value.trim().toUpperCase() !== @Json.Serialize(PalabraConfirmacion);
            });
            modal.addEventListener('show.bs.modal', function () {
                document.getElementById('elimCantidad').textContent = filas().length;
                confirmacion.value = '';
                botonEliminar.disabled = true;
            });
            modal.addEventListener('shown.bs.modal', function () { confirmacion.focus(); });
            modal.querySelector('form').addEventListener('submit', function () {
                botonEliminar.disabled = true;
                botonEliminar.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Eliminando…';
            });
            // Si otro administrador la elimina mientras esta vista está abierta, volver al listado.
            window.uafHub?.on('CapacitacionEliminada', function (id) {
                if (id === @cap.Id) location.replace('/Admin/Capacitaciones');
            });
        })();
    </script>
    <style>
        @@keyframes cap-nuevo { from { background-color: rgba(34, 197, 94, .25); } to { background-color: transparent; } }
        tr.cap-nuevo > td { animation: cap-nuevo 4s ease-out; }
    </style>
}
