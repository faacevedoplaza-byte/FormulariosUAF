@page
@model FormulariosUAF.Pages.Account.LoginModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Iniciar Sesión";
}

<div class="row justify-content-center">
    <div class="col-md-5 col-lg-4">
        <div class="card shadow border-0 mt-5">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <i class="fa-solid fa-shield-halved text-primary" style="font-size:3rem"></i>
                    <h4 class="mt-2 fw-bold">FormulariosUAF</h4>
                    <p class="text-muted small">Acceso interno</p>
                </div>

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger small">
                        <i class="fa-solid fa-circle-exclamation me-1"></i> @Model.ErrorMessage
                    </div>
                }

                <form method="post">
                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label">Correo electrónico</label>
                        <input asp-for="Input.Email" class="form-control" placeholder="usuario@empresa.cl" autofocus />
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.Password" class="form-label">Contraseña</label>
                        <input asp-for="Input.Password" class="form-control" placeholder="••••••••" />
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>
                    <div class="mb-3 form-check">
                        <input asp-for="Input.RememberMe" class="form-check-input" />
                        <label asp-for="Input.RememberMe" class="form-check-label">Recordarme</label>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fa-solid fa-right-to-bracket me-2"></i>Ingresar
                    </button>
                </form>
            </div>
        </div>
        <p class="text-center text-muted small mt-3">
            Acceso exclusivo para personal autorizado.
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
