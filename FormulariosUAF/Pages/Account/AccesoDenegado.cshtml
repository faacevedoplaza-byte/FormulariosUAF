@page
@model FormulariosUAF.Pages.Account.AccesoDenegadoModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Acceso Denegado";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow border-0 mt-5 text-center">
            <div class="card-body p-5">
                <i class="fa-solid fa-ban text-danger fs-1 mb-3"></i>
                <h4 class="fw-bold">Acceso denegado</h4>
                <p class="text-muted">
                    No tienes permisos para acceder a esta sección con tu rol actual.
                    Si crees que es un error, contacta al administrador.
                </p>
                <a href="/" class="btn btn-primary mt-2">
                    <i class="fa-solid fa-house me-2"></i> Volver al inicio
                </a>
            </div>
        </div>
    </div>
</div>
