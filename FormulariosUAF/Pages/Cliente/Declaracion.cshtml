@page
@model FormulariosUAF.Pages.Cliente.DeclaracionModel
@using FormulariosUAF.Extensions
@using FormulariosUAF.Models.Enums
@{
    Layout = "_ClientLayout";
    ViewData["Title"] = "Declaración";
    ViewData["CurrentStep"] = 1;
    var led = Model.Declaration!;
}

<div class="decl-page-head mb-4">
    <h1>Declaración</h1>
    <p>Complete la información solicitada para generar su declaración UAF.</p>
    <div class="decl-help-hint">
        <i class="fa-solid fa-circle-info"></i>
        ¿Tiene dudas? Pase el cursor o toque el ícono <i class="fa-solid fa-circle-info"></i> junto a cada campo para ver qué se pide y por qué.
    </div>
</div>

@* ── SELECTOR DE MODO: automática (asistente) o manual ───────────────────── *@
@if (Model.MostrarSelectorModo)
{
    <div id="modoSelector" class="decl-modo mb-4">
        <p class="decl-modo-intro">¿Cómo desea completar su declaración?</p>
        <div class="row g-3">
            <div class="col-md-6">
                <div class="decl-modo-card is-disabled" aria-disabled="true">
                    <span class="decl-modo-badge">Próximamente</span>
                    <div class="decl-modo-icon"><i class="fa-solid fa-wand-magic-sparkles"></i></div>
                    <h5>Automática con asistente</h5>
                    <p>Suba su <strong>Carpeta Tributaria</strong> y un asistente leerá el documento para completar los datos por usted. Solo deberá revisar y confirmar.</p>
                    <button type="button" class="btn decl-modo-btn" disabled>
                        <i class="fa-solid fa-file-arrow-up me-2"></i>Subir Carpeta Tributaria
                    </button>
                </div>
            </div>
            <div class="col-md-6">
                <div class="decl-modo-card">
                    <div class="decl-modo-icon"><i class="fa-solid fa-keyboard"></i></div>
                    <h5>Manual</h5>
                    <p>Complete usted mismo los datos de la empresa, beneficiarios finales, control efectivo, condición PEP y del declarante.</p>
                    <button type="button" id="btnModoManual" class="btn decl-modo-btn is-primary">
                        Completar manualmente <i class="fa-solid fa-arrow-right ms-2"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<div id="formDeclaracionWrap" hidden="@Model.MostrarSelectorModo">
<form method="post" id="formDeclaracion" novalidate>

    @* ── SECCIÓN 1: DATOS EMPRESA ───────────────────────────────────────────── *@
    <div class="card decl-card mb-4">
        <div class="card-header decl-card-header d-flex justify-content-between align-items-center">
            <span class="decl-sec-title"><span class="decl-sec-num">I</span>Antecedentes de la Empresa Declarante</span>
            <button type="button" id="btnEditEmpresa" class="btn btn-sm decl-ghost-btn">
                <i class="fa-solid fa-pen me-1"></i>Editar
            </button>
        </div>
        <div class="card-body p-4">

            <details class="decl-why">
                <summary><i class="fa-regular fa-lightbulb"></i>¿Por qué le pedimos esto?</summary>
                <p>La normativa nos exige identificar a la empresa con la que hacemos negocios. Estos datos los registró su ejecutivo: revíselos y, si algo no coincide, presione <strong>Editar</strong> para corregirlo.</p>
            </details>

            <div id="empresaDisplay">
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="decl-info-tile">
                            <div class="decl-info-label">RUT / N° Identificación</div>
                            <div class="decl-info-val">@led.RUT</div>
                        </div>
                    </div>
                    <div class="col-md-8">
                        <div class="decl-info-tile">
                            <div class="decl-info-label" data-help="Nombre legal de la empresa, tal como figura en su escritura y en el SII.">Razón Social</div>
                            <div class="decl-info-val">@led.BusinessName</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="decl-info-tile">
                            <div class="decl-info-label" data-help-title="@Model.RequestType.ToDisplayString()" data-help="@Model.RequestType.ToDescription()">Tipo de Solicitud</div>
                            <div class="decl-info-val">@Model.RequestType.ToDisplayString()</div>
                        </div>
                    </div>
                    <div class="col-md-5">
                        <div class="decl-info-tile">
                            <div class="decl-info-label">Domicilio</div>
                            <div class="decl-info-val">@(led.Address ?? "—")</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="decl-info-tile">
                            <div class="decl-info-label">Ciudad</div>
                            <div class="decl-info-val">@(led.City ?? "—")</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="decl-info-tile">
                            <div class="decl-info-label">País</div>
                            <div class="decl-info-val">@(led.CountryOfIncorporation ?? "—")</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="decl-info-tile">
                            <div class="decl-info-label" data-help="Forma jurídica de la empresa (S.A., Ltda., SpA, EIRL, etc.), según su escritura de constitución.">Tipo de Entidad</div>
                            <div class="decl-info-val">@led.EntityType.ToDisplayString()@(!string.IsNullOrEmpty(led.EntityTypeOther) ? $" — {led.EntityTypeOther}" : "")</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="decl-info-tile">
                            <div class="decl-info-label">Teléfono</div>
                            <div class="decl-info-val">@(led.Phone ?? "—")</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="decl-info-tile">
                            <div class="decl-info-label" data-help="Persona facultada para actuar en nombre de la empresa, según sus poderes vigentes.">RUT Representante Legal</div>
                            <div class="decl-info-val">@(led.LegalRepresentativeIdNumber ?? "—")</div>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="decl-info-tile">
                            <div class="decl-info-label">Nombre Representante Legal</div>
                            <div class="decl-info-val">@(led.LegalRepresentativeName ?? "—")</div>
                        </div>
                    </div>
                </div>
            </div>

            <div id="empresaEditPanel" style="display:none">
                <div class="alert alert-warning small mb-3">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i>
                    Los cambios que realice quedarán registrados para revisión interna.
                </div>
                <input type="hidden" asp-for="Input.EmpresaEdited" id="hidEmpresaEdited" value="false" />
                <div class="row g-3">
                    <div class="col-md-8">
                        <label class="form-label small">Domicilio</label>
                        <input asp-for="Input.EmpresaAddress" class="form-control form-control-sm" value="@led.Address" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small">Ciudad</label>
                        <input asp-for="Input.EmpresaCity" class="form-control form-control-sm" value="@led.City" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small">País</label>
                        <input asp-for="Input.EmpresaCountryOfIncorporation" class="form-control form-control-sm" value="@led.CountryOfIncorporation" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small">Teléfono</label>
                        <input asp-for="Input.EmpresaPhone" class="form-control form-control-sm" value="@led.Phone" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small">Tipo de Entidad</label>
                        <select asp-for="Input.EmpresaEntityType" class="form-select form-select-sm" id="editEntityType">
                            @foreach (var t in Enum.GetValues<EntityType>())
                            {
                                <option value="@((int)t)" selected="@(t == led.EntityType)">@t.ToDisplayString()</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4 edit-entity-other" style="display:@(led.EntityType == EntityType.Otra ? "block" : "none")">
                        <label class="form-label small">Especifique tipo</label>
                        <input asp-for="Input.EmpresaEntityTypeOther" class="form-control form-control-sm" value="@led.EntityTypeOther" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small">RUT Representante Legal</label>
                        <input asp-for="Input.EmpresaLegalRepresentativeIdNumber" class="form-control form-control-sm rut-input" value="@led.LegalRepresentativeIdNumber" />
                    </div>
                    <div class="col-md-8">
                        <label class="form-label small">Nombre Representante Legal</label>
                        <input asp-for="Input.EmpresaLegalRepresentativeName" class="form-control form-control-sm name-input" value="@led.LegalRepresentativeName" />
                    </div>
                </div>
                <button type="button" id="btnCancelarEdicion" class="btn btn-sm btn-outline-secondary mt-2">Cancelar</button>
            </div>
        </div>
    </div>

    @* ── SECCIÓN 2: ACTUALIZACIÓN SIN CAMBIOS (solo si aplica) ─────────────── *@
    @if (Model.EsActualizacionSinCambios)
    {
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-secondary text-white">
                <i class="fa-solid fa-rotate me-2"></i>Actualización de Datos sin Cambios
            </div>
            <div class="card-body p-4">
                <details class="decl-why">
                    <summary><i class="fa-regular fa-lightbulb"></i>¿Qué significa esto?</summary>
                    <p>Su empresa ya presentó esta declaración antes. Si desde entonces <strong>no ha cambiado nada</strong> (mismos dueños, mismos porcentajes, mismas personas con control), puede reiterarla aquí sin volver a ingresar a cada persona.</p>
                </details>
                <div class="form-check mb-3">
                    <input asp-for="Input.SinCambiosConfirma" class="form-check-input" id="chkSinCambios" />
                    <label asp-for="Input.SinCambiosConfirma" class="form-check-label">
                        Se reitera la información de la Declaración Jurada anterior en cuanto a que <strong>no ha habido cambios</strong> en los beneficiarios finales de la persona jurídica.
                    </label>
                </div>
                <div id="sinCambiosDetalle" class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="Input.SinCambiosNumDeclaracion" class="form-label small"
                               data-help="Aparece en el PDF de su declaración anterior, con el formato UAF-AAAA-NNNNN.">N° de declaración anterior</label>
                        <input asp-for="Input.SinCambiosNumDeclaracion" class="form-control form-control-sm" placeholder="UAF-2024-00001" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Input.SinCambiosFecha" class="form-label small"
                               data-help="Fecha en que firmó la declaración anterior. También aparece en el PDF.">Fecha de declaración anterior</label>
                        <input asp-for="Input.SinCambiosFecha" type="date" class="form-control form-control-sm" />
                    </div>
                </div>
                <div class="alert alert-info small mt-3 mb-0">
                    <i class="fa-solid fa-circle-info me-2"></i>
                    Si marcó la opción anterior y en realidad <strong>sí hubo cambios</strong>, complete la sección de beneficiarios a continuación.
                </div>
            </div>
        </div>
    }

    @* ── SECCIÓN 3: PERSONAS DECLARADAS ────────────────────────────────────── *@
    <div class="card decl-card mb-4">
        <div class="card-header decl-card-header">
            <span class="decl-sec-title"><span class="decl-sec-num">II</span>Beneficiarios Finales, Control Efectivo y Condición PEP</span>
        </div>
        <div class="card-body p-4">
            <details class="decl-why">
                <summary><i class="fa-regular fa-lightbulb"></i>¿Por qué le pedimos esto?</summary>
                <p>Por normativa de la Unidad de Análisis Financiero (UAF), debemos conocer a las <strong>personas naturales</strong> que están detrás de la empresa —quiénes son sus dueños y quiénes la controlan— y saber si alguna de ellas es una Persona Expuesta Políticamente. Es parte de la prevención del lavado de activos y del financiamiento del terrorismo.</p>
                <p class="mb-0"><strong>Ejemplo:</strong> si la empresa A pertenece en un 60% a la empresa B, y la empresa B es 100% de Juan Pérez, debe declarar a <strong>Juan Pérez</strong> (tiene indirectamente el 60%).</p>
            </details>
            <div class="decl-warn d-flex gap-2 mb-3">
                <i class="fa-solid fa-triangle-exclamation mt-1"></i>
                <div>
                    Indique las personas naturales que tienen participación igual o superior al <strong>10%</strong> en la empresa o estructura jurídica
                    (<span class="decl-term" data-help-title="Beneficiario final" data-help="Persona natural que es dueña, directa o indirectamente (a través de otras sociedades), del 10% o más del capital o de los derechos a voto de la empresa, o que ejerce control efectivo sobre ella.">beneficiarios finales</span>).
                    También debe informar personas que, aunque tengan una participación menor, <strong><span class="decl-term" data-help-title="Control efectivo" data-help="Capacidad de tomar o influir de forma decisiva en las decisiones de la empresa, aunque no se tenga el 10%. Por ejemplo: un gerente general con amplios poderes, quien controla por un pacto de accionistas o quien designa a la mayoría del directorio.">ejercen control efectivo</span></strong>, toman decisiones relevantes o influyen en la administración, fondos o pagos de la empresa.
                </div>
            </div>

            <div id="personasList">
                @for (int i = 0; i < Model.Input.Personas.Count; i++)
                {
                    var p = Model.Input.Personas[i];
                    <partial name="_PersonaDeclaradaRow" model='(Index: i.ToString(), Data: p, Catalogos: Model.Catalogos)' />
                }
            </div>

            <button type="button" id="btnAddPersona" class="btn decl-add-btn btn-sm mt-2">
                <i class="fa-solid fa-plus me-1"></i>Agregar persona
            </button>

            <div id="sinPersonasPanel" class="mt-3 border rounded p-3 bg-light" style="display:none">
                <div class="form-check">
                    <input asp-for="Input.SinPersonasConfirma" class="form-check-input" id="chkSinPersonas" />
                    <label asp-for="Input.SinPersonasConfirma" class="form-check-label small">
                        <strong>Declaro</strong> que no existen beneficiarios finales ni personas con control efectivo distintas a las ya informadas a la institución.
                    </label>
                </div>
            </div>
        </div>
    </div>

    @* ── SECCIÓN 4: DECLARANTE ──────────────────────────────────────────────── *@
    <div class="card decl-card mb-4">
        <div class="card-header decl-card-header d-flex justify-content-between align-items-center">
            <span class="decl-sec-title"><span class="decl-sec-num">III</span>Antecedentes del Declarante</span>
            @if (!string.IsNullOrWhiteSpace(led.LegalRepresentativeName))
            {
                <button type="button" id="btnUsarRepLegal" class="btn btn-sm decl-ghost-btn"
                        data-rut="@led.LegalRepresentativeIdNumber" data-nombre="@led.LegalRepresentativeName"
                        data-email="@Model.ClientEmail" data-telefono="@Model.ClientPhone">
                    <i class="fa-solid fa-paste me-1"></i>Usar datos del representante legal
                </button>
            }
        </div>
        <div class="card-body p-4">
            <p class="text-muted small mb-3">
                El declarante es la persona que completa y confirma esta información en representación de la empresa. Puede ser representante legal, socio, apoderado o una persona autorizada.
            </p>
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="Input.DeclaranteNacionalidad" class="form-label"
                           data-help="Chilena, o extranjera indicando si reside o no en Chile.">Nacionalidad</label>
                    <select asp-for="Input.DeclaranteNacionalidad" class="form-select">
                        @foreach (var n in Enum.GetValues<NationalityType>())
                        {
                            <option value="@((int)n)">@n.ToDisplayString()</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label asp-for="Input.DeclaranteIdNumber" class="form-label"
                           data-help="Su RUT, como persona que completa esta declaración. Si es extranjero sin RUT, ingrese su N° de pasaporte.">RUT / N° Identificación <span class="text-danger">*</span></label>
                    <input asp-for="Input.DeclaranteIdNumber" class="form-control rut-input" placeholder="12.345.678-9" />
                    <span asp-validation-for="Input.DeclaranteIdNumber" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Input.DeclarantePlaceOfOrigin" class="form-label"
                           data-help="Ciudad o país de donde es originario.">Lugar de origen</label>
                    <input asp-for="Input.DeclarantePlaceOfOrigin" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Input.DeclaranteFirstName" class="form-label">Nombres <span class="text-danger">*</span></label>
                    <input asp-for="Input.DeclaranteFirstName" class="form-control name-input" />
                    <span asp-validation-for="Input.DeclaranteFirstName" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Input.DeclaranteLastName1" class="form-label">Apellido paterno <span class="text-danger">*</span></label>
                    <input asp-for="Input.DeclaranteLastName1" class="form-control name-input" />
                    <span asp-validation-for="Input.DeclaranteLastName1" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Input.DeclaranteLastName2" class="form-label">Apellido materno</label>
                    <input asp-for="Input.DeclaranteLastName2" class="form-control name-input" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.DeclaranteRelationship" class="form-label"
                           data-help="Calidad en la que firma por la empresa: representante legal, socio, apoderado, gerente, etc.">Relación con la empresa <span class="text-danger">*</span></label>
                    <input asp-for="Input.DeclaranteRelationship" class="form-control" placeholder="Ej: Representante Legal, Apoderado..." />
                    <span asp-validation-for="Input.DeclaranteRelationship" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="Input.DeclaranteCity" class="form-label"
                           data-help="Ciudad en la que se encuentra al firmar esta declaración.">Ciudad de firma <span class="text-danger">*</span></label>
                    <input asp-for="Input.DeclaranteCity" class="form-control" />
                    <span asp-validation-for="Input.DeclaranteCity" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label class="form-label" data-help="Se completa automáticamente con la fecha de hoy.">Fecha</label>
                    <input type="text" class="form-control bg-light" value="@DateTime.Today.ToString("dd/MM/yyyy")" readonly />
                </div>
                <div class="col-md-5">
                    <label asp-for="Input.DeclaranteEmail" class="form-label">Correo electrónico</label>
                    <input asp-for="Input.DeclaranteEmail" type="email" class="form-control" />
                    <span asp-validation-for="Input.DeclaranteEmail" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="Input.DeclarantePhone" class="form-label">Teléfono</label>
                    <input asp-for="Input.DeclarantePhone" class="form-control" placeholder="+56 9..." />
                </div>
            </div>

            <hr class="my-4" />
            <h6 class="text-primary"><i class="fa-solid fa-signature me-2"></i>Declaración bajo juramento y firma</h6>
            <details class="decl-why mt-2">
                <summary><i class="fa-regular fa-lightbulb"></i>¿Qué estoy firmando?</summary>
                <p class="mb-0">Una <strong>declaración jurada</strong>: usted confirma, bajo juramento, que la información de este formulario es completa y verdadera. Su nombre y RUT quedan como firma en el documento PDF que se genera. Normalmente son los mismos datos del declarante.</p>
            </details>
            <div class="row g-3 mt-1">
                <div class="col-md-6">
                    <label asp-for="Input.FirmaFullName" class="form-label"
                           data-help="Su nombre completo, tal como aparecerá en la firma del documento.">Nombre completo (para firma) <span class="text-danger">*</span></label>
                    <input asp-for="Input.FirmaFullName" class="form-control name-input" />
                    <span asp-validation-for="Input.FirmaFullName" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Input.FirmaIdNumber" class="form-label"
                           data-help="Su RUT, que acompaña a la firma en el documento.">RUT (para firma) <span class="text-danger">*</span></label>
                    <input asp-for="Input.FirmaIdNumber" class="form-control rut-input" />
                    <span asp-validation-for="Input.FirmaIdNumber" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <div class="form-check border rounded p-3 bg-light">
                        <input asp-for="Input.FirmaDeclaraJuramento" class="form-check-input" />
                        <label asp-for="Input.FirmaDeclaraJuramento" class="form-check-label fw-semibold">
                            Declaro bajo juramento que la información proporcionada en este formulario es completa y veraz, y que me hago responsable de su contenido conforme a la normativa vigente.
                        </label>
                        <span asp-validation-for="Input.FirmaDeclaraJuramento" class="text-danger d-block small mt-1"></span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">
            <i class="fa-solid fa-circle-exclamation me-2"></i>@Model.ErrorMessage
        </div>
    }

    <div class="decl-actions d-flex justify-content-between align-items-center mb-5">
        <p class="decl-required-hint mb-0">Los campos marcados con <span class="req">*</span> son obligatorios</p>
        <button type="submit" class="btn btn-primary decl-submit">
            Continuar a Adjuntos <i class="fa-solid fa-arrow-right ms-2"></i>
        </button>
    </div>

</form>
</div>

@* Template para nueva fila de persona (reemplaza __IDX__ en JS) *@
<template id="personaRowTemplate">
    <partial name="_PersonaDeclaradaRow" model='(Index: "__IDX__", Data: new FormulariosUAF.Pages.Cliente.DeclaracionModel.PersonaInput(), Catalogos: Model.Catalogos)' />
</template>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
<script>
// ── Ayudas: cada [data-help] recibe un ícono (i) con un popover explicativo.
//    En escritorio se abre al pasar el mouse; en celular/tablet, al tocarlo.
//    Los términos .decl-term (PEP, beneficiario final...) son ellos mismos el disparador.
const ayudaHover = window.matchMedia('(hover: hover)').matches;
function initAyudas(root) {
    root.querySelectorAll('[data-help]').forEach(el => {
        if (el.dataset.helpInit) return;
        el.dataset.helpInit = '1';
        let trigger = el;
        if (!el.classList.contains('decl-term')) {
            trigger = document.createElement('button');
            trigger.type = 'button';
            trigger.className = 'decl-help-btn';
            trigger.setAttribute('aria-label', 'Ayuda');
            trigger.innerHTML = '<i class="fa-solid fa-circle-info"></i>';
            trigger.addEventListener('click', e => e.preventDefault()); // no marcar el checkbox del label
            el.appendChild(trigger);
        } else {
            el.tabIndex = 0;
            el.setAttribute('role', 'button');
        }
        new bootstrap.Popover(trigger, {
            content: el.dataset.help,
            title: el.dataset.helpTitle || '',
            trigger: ayudaHover ? 'hover focus' : 'click',
            placement: 'top',
            container: 'body',
            customClass: 'decl-popover'
        });
    });
}
// En táctil: tocar fuera cierra el popover abierto
if (!ayudaHover) {
    document.addEventListener('click', e => {
        if (e.target.closest('.decl-help-btn, .decl-term, .popover')) return;
        document.querySelectorAll('.decl-help-btn, .decl-term').forEach(b => bootstrap.Popover.getInstance(b)?.hide());
    });
}
initAyudas(document);

// ── Selector de modo: "Manual" muestra el formulario
document.getElementById('btnModoManual')?.addEventListener('click', () => {
    document.getElementById('modoSelector')?.remove();
    document.getElementById('formDeclaracionWrap').hidden = false;
    window.scrollTo({ top: 0, behavior: 'smooth' });
});

// ── Empresa edit toggle
const btnEdit = document.getElementById('btnEditEmpresa');
const btnCancel = document.getElementById('btnCancelarEdicion');
const display = document.getElementById('empresaDisplay');
const editPanel = document.getElementById('empresaEditPanel');
const hidEdited = document.getElementById('hidEmpresaEdited');

btnEdit?.addEventListener('click', () => {
    display.style.display = 'none';
    editPanel.style.display = 'block';
    hidEdited.value = 'true';
});
btnCancel?.addEventListener('click', () => {
    display.style.display = 'block';
    editPanel.style.display = 'none';
    hidEdited.value = 'false';
});
const editEntityType = document.getElementById('editEntityType');
const editOtraVal = '@((int)EntityType.Otra)';
editEntityType?.addEventListener('change', () => {
    document.querySelector('.edit-entity-other').style.display = editEntityType.value === editOtraVal ? 'block' : 'none';
});

// ── Personas dinámicas
const list = document.getElementById('personasList');
const template = document.getElementById('personaRowTemplate');
const btnAdd = document.getElementById('btnAddPersona');
const sinPersonasPanel = document.getElementById('sinPersonasPanel');
let idx = @Model.Input.Personas.Count;

function updateNumbers() {
    list.querySelectorAll('.persona-row').forEach((row, i) => {
        row.querySelector('.persona-num').textContent = i + 1;
    });
    sinPersonasPanel.style.display = list.querySelectorAll('.persona-row').length === 0 ? 'block' : 'none';
}

function bindRowEvents(row) {
    row.querySelector('.btn-remove-persona')?.addEventListener('click', () => {
        row.querySelectorAll('.decl-help-btn').forEach(b => bootstrap.Popover.getInstance(b)?.dispose());
        row.remove();
        renumberRows();
        updateNumbers();
    });
    // Tipo de documento: solo el RUT se autoformatea (12.345.678-9)
    row.querySelector('.sel-tipodoc')?.addEventListener('change', e => {
        const esRut = e.target.value === '@FormulariosUAF.Models.Domain.TipoDocumento.IdRut';
        const inp = row.querySelector('.inp-idnumber');
        inp.classList.toggle('rut-input', esRut);
        inp.placeholder = esRut ? '12.345.678-9' : 'N° de documento';
    });
    row.querySelector('.chk-control')?.addEventListener('change', e => {
        row.querySelector('.desc-control').style.display = e.target.checked ? 'block' : 'none';
    });
    row.querySelector('.chk-pep')?.addEventListener('change', e => {
        row.querySelector('.pep-detail').style.display = e.target.checked ? 'block' : 'none';
        // Al marcar PEP, copia el nombre de la persona al campo "Nombre PEP" (si está vacío)
        if (e.target.checked) {
            const nombre = row.querySelector('[name$=".FullName"]')?.value || '';
            const pepNombre = row.querySelector('[name$=".PepTypeName"]');
            if (pepNombre && !pepNombre.value) pepNombre.value = nombre;
        }
    });
    const pctInput = row.querySelector('.pct-input');
    const chk10 = row.querySelector('.chk-10pct');
    pctInput?.addEventListener('input', () => {
        if (chk10) chk10.checked = parseFloat(pctInput.value || 0) >= 10;
    });
}

function renumberRows() {
    list.querySelectorAll('.persona-row').forEach((row, i) => {
        row.setAttribute('data-idx', i);
        row.querySelectorAll('[name]').forEach(el => {
            el.name = el.name.replace(/Personas\[\d+\]/, `Personas[${i}]`);
        });
    });
    idx = list.querySelectorAll('.persona-row').length;
}

btnAdd?.addEventListener('click', () => {
    const clone = template.content.cloneNode(true);
    const div = clone.querySelector('.persona-row');
    div.innerHTML = div.innerHTML.replaceAll('__IDX__', idx);
    div.setAttribute('data-idx', idx);
    idx++;
    list.appendChild(div);
    bindRowEvents(list.lastElementChild);
    initAyudas(list.lastElementChild);
    updateNumbers();
});

// Bind events on pre-rendered rows
list.querySelectorAll('.persona-row').forEach(bindRowEvents);
updateNumbers();

// Re-number on submit to ensure sequential indices
document.getElementById('formDeclaracion')?.addEventListener('submit', renumberRows);

// ── Botón: usar datos del representante legal en el declarante
function setVal(id, v) { const el = document.getElementById(id); if (el) el.value = v ?? ''; }
document.getElementById('btnUsarRepLegal')?.addEventListener('click', function () {
    const rut = (this.dataset.rut || '').trim();
    const nombre = (this.dataset.nombre || '').trim();

    // RUT (declarante y firma), ya formateado
    const rutFmt = (typeof formatRUT === 'function' && formatRUT(rut)) || rut;
    setVal('Input_DeclaranteIdNumber', rutFmt);
    setVal('Input_FirmaIdNumber', rutFmt);

    // Reparto aproximado del nombre: los 2 últimos tokens = apellidos
    const parts = nombre.split(/\s+/).filter(Boolean);
    let nombres = '', ap1 = '', ap2 = '';
    if (parts.length === 1) { nombres = parts[0]; }
    else if (parts.length === 2) { nombres = parts[0]; ap1 = parts[1]; }
    else if (parts.length === 3) { nombres = parts[0]; ap1 = parts[1]; ap2 = parts[2]; }
    else if (parts.length >= 4) { ap2 = parts.pop(); ap1 = parts.pop(); nombres = parts.join(' '); }
    setVal('Input_DeclaranteFirstName', nombres);
    setVal('Input_DeclaranteLastName1', ap1);
    setVal('Input_DeclaranteLastName2', ap2);
    setVal('Input_DeclaranteRelationship', 'Representante Legal');
    setVal('Input_FirmaFullName', nombre);

    // Contacto del cliente registrado por el vendedor (correo y teléfono)
    const email = (this.dataset.email || '').trim();
    const tel = (this.dataset.telefono || '').trim();
    if (email) setVal('Input_DeclaranteEmail', email);
    if (tel) setVal('Input_DeclarantePhone', tel);

    if (typeof showToast === 'function')
        showToast('Datos del representante legal y contacto del cliente copiados. Verifique nombres y apellidos.', 'info');
});
</script>
}
