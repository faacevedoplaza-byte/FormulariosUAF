@page
@model FormulariosUAF.Pages.Cliente.InicioModel
@{
    Layout = "_ClientLayout";
    ViewData["Title"] = "Bienvenido";
}

<div class="decl-welcome">
    <div class="decl-welcome-card">
        @if (Model.RequestInfo is not null)
        {
            <div class="decl-welcome-logo"><i class="fa-solid fa-shield-halved"></i></div>
            <h3 class="decl-welcome-title">Declaración Digital</h3>
            <p class="decl-welcome-sub">Has sido invitado a completar la declaración de Beneficiario Final y PEP para:</p>
            <div class="decl-welcome-company">
                <div class="name">@Model.RequestInfo.ClientRazonSocial</div>
                <div class="rut">RUT: @Model.RequestInfo.ClientRut</div>
            </div>
            <p class="decl-welcome-expiry">
                <i class="fa-solid fa-clock me-1"></i>Este enlace vence el <strong>@Model.RequestInfo.Expiry.ToString("dd/MM/yyyy HH:mm")</strong>
            </p>
            <div class="decl-welcome-note">
                <i class="fa-solid fa-circle-info mt-1"></i>
                <span>La información declarada será utilizada para procesos de debida diligencia y conocimiento del cliente, conforme a la normativa vigente.</span>
            </div>
            <form method="post" class="mt-4">
                <input type="hidden" asp-for="Token" />
                <button type="submit" class="btn decl-welcome-btn btn-lg">
                    <i class="fa-solid fa-play me-2"></i>Iniciar Declaración
                </button>
            </form>
        }
        else
        {
            <div class="decl-welcome-logo is-error"><i class="fa-solid fa-circle-xmark"></i></div>
            <h3 class="decl-welcome-title">Enlace no válido</h3>
            <p class="decl-welcome-sub">@Model.ErrorMessage</p>
        }
    </div>
</div>
