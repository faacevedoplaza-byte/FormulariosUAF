@page
@model FormulariosUAF.Pages.Cliente.Paso3Model
@{
    Layout = "_ClientLayout";
    ViewData["Title"] = "Control Efectivo";
    ViewData["CurrentStep"] = 3;
}

<div class="card border-0 shadow">
    <div class="card-header bg-primary text-white">
        <i class="fa-solid fa-user-tie me-2"></i>Paso 3: Personas de Control Efectivo
    </div>
    <div class="card-body p-4">
        <div class="alert alert-info small">
            <i class="fa-solid fa-circle-info me-1"></i>
            Declare las personas naturales que ejercen <strong>control efectivo</strong> sobre la persona jurídica, aunque su participación sea inferior al 10%.
        </div>

        <form method="post">
            <div id="control-container">
                @for (int i = 0; i < Model.Controllers.Count; i++)
                {
                    var c = Model.Controllers[i];
                    <div class="control-row card border mb-3 p-3">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="fw-bold text-primary small">Persona de Control</span>
                            <button type="button" class="btn btn-sm btn-outline-danger btn-remove">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </div>
                        <div class="row g-2">
                            <div class="col-md-4">
                                <label class="form-label small">RUT / N° ID <span class="text-danger">*</span></label>
                                <input name="controllers[@i].IdNumber" value="@c.IdNumber" class="form-control form-control-sm" required />
                            </div>
                            <div class="col-md-8">
                                <label class="form-label small">Nombre Completo <span class="text-danger">*</span></label>
                                <input name="controllers[@i].FullName" value="@c.FullName" class="form-control form-control-sm" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small">Domicilio</label>
                                <input name="controllers[@i].Address" value="@c.Address" class="form-control form-control-sm" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small">Ciudad</label>
                                <input name="controllers[@i].City" value="@c.City" class="form-control form-control-sm" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small">País</label>
                                <input name="controllers[@i].Country" value="@(string.IsNullOrEmpty(c.Country) ? "Chile" : c.Country)" class="form-control form-control-sm" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small">% Participación (si aplica)</label>
                                <input name="controllers[@i].ParticipationPercentage" value="@c.ParticipationPercentage" type="number" step="0.01" min="0" max="100" class="form-control form-control-sm" />
                            </div>
                            <div class="col-md-9">
                                <label class="form-label small">Descripción del control / Cargo <span class="text-danger">*</span></label>
                                <input name="controllers[@i].ControlDescription" value="@c.ControlDescription" class="form-control form-control-sm" placeholder="Ej: Gerente General, Accionista Controlador..." required />
                            </div>
                            <div class="col-md-3 d-flex align-items-end">
                                <div class="form-check">
                                    <input class="form-check-input ctrl-pep" type="checkbox" name="controllers[@i].IsPEP" value="true"
                                           id="cpep_@i" @(c.IsPEP ? "checked" : "") />
                                    <label class="form-check-label small" for="cpep_@i">¿Es PEP?</label>
                                </div>
                            </div>
                            <div class="col-12 cpep-detail" style="display:@(c.IsPEP ? "block" : "none")">
                                <label class="form-label small">Detalle PEP</label>
                                <input name="controllers[@i].PepDetail" value="@c.PepDetail" class="form-control form-control-sm" />
                            </div>
                        </div>
                    </div>
                }
            </div>

            <button type="button" class="btn btn-outline-primary mt-2" id="addCtrl">
                <i class="fa-solid fa-plus me-1"></i>Agregar Persona de Control
            </button>

            <input type="hidden" name="count" id="ctrlCount" value="@Model.Controllers.Count" />

            <div class="d-flex justify-content-between mt-4">
                <a href="/Cliente/Paso2" class="btn btn-outline-secondary">
                    <i class="fa-solid fa-arrow-left me-1"></i>Anterior
                </a>
                <button type="submit" class="btn btn-primary px-4">
                    Guardar y Continuar <i class="fa-solid fa-arrow-right ms-1"></i>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
let ci = parseInt(document.getElementById('ctrlCount').value) || 0;
document.getElementById('addCtrl').addEventListener('click', () => {
    const html = `<div class="control-row card border mb-3 p-3">
        <div class="d-flex justify-content-between mb-2">
            <span class="fw-bold text-primary small">Persona de Control</span>
            <button type="button" class="btn btn-sm btn-outline-danger btn-remove"><i class="fa-solid fa-trash"></i></button>
        </div>
        <div class="row g-2">
            <div class="col-md-4"><label class="form-label small">RUT / N° ID *</label>
                <input name="controllers[${ci}].IdNumber" class="form-control form-control-sm" required /></div>
            <div class="col-md-8"><label class="form-label small">Nombre Completo *</label>
                <input name="controllers[${ci}].FullName" class="form-control form-control-sm" required /></div>
            <div class="col-md-6"><label class="form-label small">Domicilio</label>
                <input name="controllers[${ci}].Address" class="form-control form-control-sm" /></div>
            <div class="col-md-3"><label class="form-label small">Ciudad</label>
                <input name="controllers[${ci}].City" class="form-control form-control-sm" /></div>
            <div class="col-md-3"><label class="form-label small">País</label>
                <input name="controllers[${ci}].Country" value="Chile" class="form-control form-control-sm" /></div>
            <div class="col-md-3"><label class="form-label small">% Participación</label>
                <input name="controllers[${ci}].ParticipationPercentage" type="number" step="0.01" min="0" max="100" class="form-control form-control-sm" /></div>
            <div class="col-md-9"><label class="form-label small">Descripción / Cargo *</label>
                <input name="controllers[${ci}].ControlDescription" class="form-control form-control-sm" required /></div>
            <div class="col-md-3 d-flex align-items-end">
                <div class="form-check"><input class="form-check-input ctrl-pep" type="checkbox" name="controllers[${ci}].IsPEP" value="true" id="cpep_${ci}" />
                <label class="form-check-label small" for="cpep_${ci}">¿Es PEP?</label></div>
            </div>
            <div class="col-12 cpep-detail" style="display:none">
                <label class="form-label small">Detalle PEP</label>
                <input name="controllers[${ci}].PepDetail" class="form-control form-control-sm" /></div>
        </div></div>`;
    document.getElementById('control-container').insertAdjacentHTML('beforeend', html);
    ci++; document.getElementById('ctrlCount').value = ci;
    bindEvents();
});

function bindEvents() {
    document.querySelectorAll('.btn-remove').forEach(b => { b.onclick = () => b.closest('.control-row').remove(); });
    document.querySelectorAll('.ctrl-pep').forEach(cb => {
        cb.onchange = function() { this.closest('.control-row').querySelector('.cpep-detail').style.display = this.checked ? 'block' : 'none'; };
    });
}
bindEvents();
</script>
}
