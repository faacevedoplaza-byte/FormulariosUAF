@page
@model FormulariosUAF.Pages.Cliente.Paso5Model
@{
    Layout = "_ClientLayout";
    ViewData["Title"] = "Datos del Declarante";
    ViewData["CurrentStep"] = 5;
}

<div class="card border-0 shadow">
    <div class="card-header bg-primary text-white">
        <i class="fa-solid fa-user me-2"></i>Paso 5: Antecedentes de la Persona Natural que Realiza la Declaración
    </div>
    <div class="card-body p-4">
        <form method="post">
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="Input.NationalityType" class="form-label">Nacionalidad <span class="text-danger">*</span></label>
                    <select asp-for="Input.NationalityType" class="form-select">
                        @foreach (var n in Enum.GetValues<FormulariosUAF.Models.Enums.NationalityType>())
                        {
                            <option value="@((int)n)">@n.ToDisplayString()</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label asp-for="Input.IdNumber" class="form-label">RUT / N° Identificación <span class="text-danger">*</span></label>
                    <input asp-for="Input.IdNumber" class="form-control" />
                    <span asp-validation-for="Input.IdNumber" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Input.PlaceOfOrigin" class="form-label">Lugar de Origen</label>
                    <input asp-for="Input.PlaceOfOrigin" class="form-control" placeholder="Ciudad, País" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Input.FirstName" class="form-label">Nombres <span class="text-danger">*</span></label>
                    <input asp-for="Input.FirstName" class="form-control" />
                    <span asp-validation-for="Input.FirstName" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Input.LastName1" class="form-label">Apellido Paterno <span class="text-danger">*</span></label>
                    <input asp-for="Input.LastName1" class="form-control" />
                    <span asp-validation-for="Input.LastName1" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Input.LastName2" class="form-label">Apellido Materno</label>
                    <input asp-for="Input.LastName2" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.RelationshipWithLegalEntity" class="form-label">Relación con la Persona Jurídica <span class="text-danger">*</span></label>
                    <input asp-for="Input.RelationshipWithLegalEntity" class="form-control" placeholder="Ej: Representante Legal, Socio, Gerente..." />
                    <span asp-validation-for="Input.RelationshipWithLegalEntity" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="Input.City" class="form-label">Ciudad <span class="text-danger">*</span></label>
                    <input asp-for="Input.City" class="form-control" />
                    <span asp-validation-for="Input.City" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="Input.DeclarationDate" class="form-label">Fecha Declaración <span class="text-danger">*</span></label>
                    <input asp-for="Input.DeclarationDate" type="date" class="form-control" />
                    <span asp-validation-for="Input.DeclarationDate" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <div class="card border-warning">
                        <div class="card-body py-3">
                            <div class="form-check">
                                <input class="form-check-input @(ViewData.ModelState["Input.DeclaresUnderOath"]?.Errors.Count > 0 ? "is-invalid" : "")"
                                       type="checkbox" asp-for="Input.DeclaresUnderOath" />
                                <label class="form-check-label fw-semibold" asp-for="Input.DeclaresUnderOath">
                                    Declaro bajo juramento que la información proporcionada es veraz y fidedigna.
                                    <span class="text-danger">*</span>
                                </label>
                                <div class="invalid-feedback d-block">
                                    <span asp-validation-for="Input.DeclaresUnderOath"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger small mt-3">@Model.ErrorMessage</div>
            }

            <div class="d-flex justify-content-between mt-4">
                <a href="/Cliente/Paso4" class="btn btn-outline-secondary">
                    <i class="fa-solid fa-arrow-left me-1"></i>Anterior
                </a>
                <button type="submit" class="btn btn-primary px-4">
                    Guardar y Continuar <i class="fa-solid fa-arrow-right ms-1"></i>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
<script>
// Pre-fill today's date if empty
const dateInput = document.querySelector('input[name="Input.DeclarationDate"]');
if (dateInput && !dateInput.value) {
    dateInput.value = new Date().toISOString().split('T')[0];
}
</script>
}
